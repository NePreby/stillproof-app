{
  "expo": {
    "name": "Stillproof",
    "slug": "stillproof-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.stillprooflabs.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "io.github.stillprooflabs.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Stillproof uses the camera to capture photos and sign them on this device.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F0E0C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#0F0E0C"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Stillproof reads a photo you choose to check its proof. It doesn't upload the photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "./modules/stillproof-keys/app.plugin.js"
    ],
    "backgroundColor": "#0F0E0C"
  }
}
